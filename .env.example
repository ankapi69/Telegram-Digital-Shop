# =========================================================================
# Core
# =========================================================================
BOT_TOKEN=123456:replace-me

# Roles. Comma-separated Telegram IDs.
SUPERADMIN_IDS=123456789
MANAGER_IDS=
SUPPORT_IDS=

# SQLAlchemy URL.
# Dev:  sqlite+aiosqlite:///./shop.db
# Prod: postgresql+asyncpg://shop:shop@db:5432/shop
DATABASE_URL=sqlite+aiosqlite:///./shop.db

# Redis URL. Required for cart storage; falls back to MemoryStorage for FSM
# if not set (single worker only).
REDIS_URL=

# Group chats for ops notifications. 0 disables.
# New orders / manual-fulfillment requests go to NOTIFY_GROUP_ID.
# "Support" button forwards user messages to SUPPORT_GROUP_ID.
NOTIFY_GROUP_ID=0
SUPPORT_GROUP_ID=0

THROTTLE_RATE=0.5
LOG_LEVEL=INFO

CATALOG_CACHE_TTL=60
CART_TTL_SECONDS=86400
BROADCAST_RATE_PER_SEC=25

# Exchange rate: USDT/RUB pulled from CoinGecko + this markup (%) for spread.
# Fallback used when CoinGecko is unreachable and the DB has no cached value.
RUB_USD_MARKUP=3.0
RUB_USD_FALLBACK=95.0
RATES_REFRESH_INTERVAL=3600

# =========================================================================
# Webhook server (optional)
# =========================================================================
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081
WEBHOOK_PUBLIC_URL=
WEBHOOK_BASE_PATH=/payments

# =========================================================================
# CryptoBot (@CryptoBot → Crypto Pay → Create App)
# =========================================================================
CRYPTOBOT_TOKEN=
CRYPTOBOT_ASSET=USDT
CRYPTOBOT_TESTNET=false

# =========================================================================
# Lava.ru Business
# =========================================================================
LAVA_SECRET_KEY=
LAVA_SHOP_ID=
LAVA_SUCCESS_URL=
LAVA_FAIL_URL=
