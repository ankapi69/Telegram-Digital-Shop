# =========================================================================
# Core
# =========================================================================

# Telegram bot token from @BotFather
BOT_TOKEN=123456:replace-me

# Comma-separated Telegram user IDs that have admin access.
ADMIN_IDS=123456789

# SQLAlchemy URL.
#   - SQLite (dev):     sqlite+aiosqlite:///./shop.db
#   - PostgreSQL (prod): postgresql+asyncpg://user:pass@host:5432/shop
DATABASE_URL=sqlite+aiosqlite:///./shop.db

# Optional Redis URL for FSM storage. Without it MemoryStorage is used
# (fine for a single worker; switch to Redis to scale horizontally).
REDIS_URL=

# Anti-spam: minimum seconds between two messages from the same user.
THROTTLE_RATE=0.5

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO


# =========================================================================
# Webhook server (optional). When disabled, payments are still checked
# manually via the "Проверить оплату" button.
# =========================================================================

WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081
# Public URL (https) the providers will POST to. Leave empty to disable
# webhooks even with the server running.
WEBHOOK_PUBLIC_URL=
WEBHOOK_BASE_PATH=/payments


# =========================================================================
# CryptoBot (https://t.me/CryptoBot → Crypto Pay → Create App)
# =========================================================================

CRYPTOBOT_TOKEN=
# Any asset supported by Crypto Pay: USDT, TON, BTC, ETH, BNB, TRX, USDC, ...
CRYPTOBOT_ASSET=USDT
CRYPTOBOT_TESTNET=false


# =========================================================================
# Lava.ru Business (https://lava.ru → Кабинет → API)
# =========================================================================

LAVA_SECRET_KEY=
LAVA_SHOP_ID=
# Optional return URLs (deep links into your bot work well):
LAVA_SUCCESS_URL=
LAVA_FAIL_URL=
